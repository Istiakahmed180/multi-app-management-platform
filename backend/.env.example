# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

MONGODB_URI=mongodb://localhost:27017/app_management

# Comma-separated dashboard origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:8080
# Number of reverse proxies in front of the API (for correct client IPs / rate limits).
TRUST_PROXY=0
# Defaults to true in staging/production. Set false only for plain-http local development.
# COOKIE_SECURE=false
# COOKIE_DOMAIN=

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
PUBLIC_RATE_LIMIT_MAX=120
BODY_LIMIT=256kb
PUBLIC_CONFIG_CACHE_SECONDS=60

AUDIT_RETENTION_DAYS=365
METRICS_RETENTION_DAYS=90
EVENTS_RETENTION_DAYS=90
INVITATION_TTL_DAYS=7

# Used to build invitation links, e.g. http://localhost:8080
DASHBOARD_URL=http://localhost:8080

WORKERS_ENABLED=true
SYNC_INDEXES_ON_START=true
CAMPAIGN_POLL_INTERVAL_MS=15000

# S3-compatible storage (optional). Leave empty to disable uploads.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Error tracker DSN (integration point in src/shared/error-reporter.ts).
ERROR_TRACKING_DSN=

# Used only by `npm run seed` (development only).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
